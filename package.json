{
  "name": "brickmedic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A FalkorDB-powered repair agent for disconnected brick models",
  "engines": {
    "node": "^22.14.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web 'tsx watch src/server/index.ts' 'vite --host 127.0.0.1'",
    "build": "node scripts/render-blog.mjs && tsc --noEmit && vite build",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/integration.test.ts",
    "test:integration": "vitest run tests/integration.test.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "falkordb": "^6.8.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.58.0",
    "posthog-js": "^1.438.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "marked": "^18.1.1",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
